{
  "name": "bancada",
  "productName": "Bancada",
  "version": "2.0.0",
  "description": "Optimizador de cortes y diseño de muebles para carpinteros y herreros",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --no-warnings scripts/correr-pruebas-ci.mjs",
    "test:empaquetado": "node --no-warnings scripts/correr-pruebas-ci.mjs empaquetado",
    "contenido:generar-clave": "node scripts/contenido-cifrado.mjs generar-clave",
    "contenido:cifrar": "node scripts/contenido-cifrado.mjs cifrar",
    "contenido:descifrar": "node scripts/contenido-cifrado.mjs descifrar",
    "contenido:verificar": "node scripts/contenido-cifrado.mjs verificar",
    "precalentar": "node scripts/precalentar-electron.mjs",
    "icono:mac": "electron scripts/hacer-icono-mac.js",
    "build:mac": "electron-builder --mac --publish never -c.npmRebuild=false && node scripts/verify-firma-mac.mjs",
    "verify:firma-mac": "node scripts/verify-firma-mac.mjs",
    "entrega:mac": "node scripts/armar-entrega-mac.mjs"
  },
  "author": {
    "name": "Bancada"
  },
  "license": "UNLICENSED",
  "bancada": {
    "edicion": "ar",
    "idioma": "es-AR",
    "region": "es-AR",
    "carpetaDatosPortable": "Datos Bancada"
  },
  "devDependencies": {
    "electron": "^43.7.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bancada.desktop",
    "productName": "Bancada",
    "copyright": "© 2026 Bancada",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "electronLanguages": ["es-419", "es", "en-US"],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!**/*.md",
      "!**/*.ps1",
      "!**/*.test.mjs",
      "!**/*.bancada",
      "!**/*.map",
      "!src/i18n/claves/**",
      "!src/i18n/permitidos/**"
    ],
    "fileAssociations": [
      {
        "ext": "bancada",
        "name": "Bancada.Trabajo",
        "description": "Trabajo de Bancada",
        "icon": "archivo.icns",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "electronLanguages": ["es", "es_419", "es-419", "en", "en_US", "en-US"],
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Bancada solo abre y guarda los trabajos y los PDF que vos elegís. Nada de lo que abrís se envía a ningún lado.",
        "NSDesktopFolderUsageDescription": "Bancada solo abre y guarda los trabajos y los PDF que vos elegís. Nada de lo que abrís se envía a ningún lado.",
        "NSDownloadsFolderUsageDescription": "Bancada solo abre y guarda los trabajos y los PDF que vos elegís. Nada de lo que abrís se envía a ningún lado.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.bancada.desktop.trabajo",
            "UTTypeDescription": "Trabajo de Bancada",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeIconFile": "archivo.icns",
            "UTTypeTagSpecification": { "public.filename-extension": ["bancada"] }
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "Bancada-${version}-macOS-${arch}.${ext}",
      "title": "Bancada ${version}",
      "sign": false,
      "writeUpdateInfo": false
    }
  }
}
